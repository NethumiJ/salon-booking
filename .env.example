# Copy to .env.local (dev) / set in Vercel Project Settings > Environment Variables
TURSO_DATABASE_URL=libsql://your-db-name-yourorg.turso.io
TURSO_AUTH_TOKEN=
SESSION_SECRET=   # 48+ random chars: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=   # npm run hash-password -- "your long password"
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app
# WhatsApp (not wired yet)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Demo only: show OTP on screen. NEVER set in real production
DEV_SHOW_OTP=
